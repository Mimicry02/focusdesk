{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/*.js":{"maxDuration":60}},
 "crons":[{"path":"/api/telegram-cron?mode=morning","schedule":"0 2 * * *"},{"path":"/api/telegram-cron?mode=evening","schedule":"30 10 * * *"},{"path":"/api/digest","schedule":"0 1 * * *"}],
 "headers":[{"source":"/(.*)","headers":[
  {"key":"X-Content-Type-Options","value":"nosniff"},
  {"key":"Referrer-Policy","value":"no-referrer"},
  {"key":"X-Frame-Options","value":"DENY"},
  {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
 ]}]
}
